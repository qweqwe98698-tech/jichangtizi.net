  { name: '全球云', year: '2026', price: '20 元/月', traffic: '120GB', type: '月付', line: 'VLESS / IEPL', pos: '20元综合型', affUrl: 'https://guangs.gcvipaff.com/#/?code=Ov2nvU9C' },
  { name: 'SOGO 云', year: '2026', price: '25 元/月', traffic: '150GB', type: '月付', line: 'VLESS / IEPL', pos: '25元综合型', affUrl: 'https://guangs.sogoyunaff.cc/#/?code=327Vs0w7' },
  { name: '可信云', year: '2024', price: '25 元/月', traffic: '150GB', type: '月付', line: 'VLESS / IEPL', pos: '150GB专线型', affUrl: 'https://guangs.kosingaff.com/#/register?code=UYDtNlCY' },
  { name: '速界', year: '2024', price: '25 元/月', traffic: '150GB', type: '月付', line: 'VLESS / IEPL', pos: 'AI 场景首选', affUrl: 'https://guangs.speedworldaff.cc/#/register?code=xgXzEfZB' },
  { name: '快狸', year: '2023', price: '25 元/月', traffic: '150GB', type: '月付', line: 'VLESS / IEPL', pos: '综合使用型', affUrl: 'https://guangs.kuailicloud.cc/#/register?code=AiqyM8oG' },
