const webSiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: siteTitle,
      description: siteDescription,
      inLanguage: locale,
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/#airport-ranking`,
      name: '2026 精选机场推荐排行榜',
      itemListElement: airports.map((ap, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: ap.name,
        description: ap.tagline,
      })),
    },
  ],
};
---

<PageShell
  title={siteTitle}
  description={siteDescription}
  schema={webSiteSchema}
  transparentHeader={true}
  pageId="home"
>
  <HeroHeader
    text={homeHero.text}
    subtitle={homeHero.subtitle}
    backgroundImage={homeHero.backgroundImage}
    interactive={true}
  />

  <div class="stats-wrapper">
    <ContentCard id="stats-card">
      <div class="editorial-home-container">
        
        <!-- 01 / RECOMMENDED 编辑部精选机场列表 (纵向杂志式排行榜) -->
        <section class="editorial-ranking-section" id="ranking">
          <div class="section-header-wrap">
            <span class="section-badge-tag">01 / RECOMMENDED</span>
            <h2 class="editorial-section-title">2026 精选机场推荐</h2>
            <p class="editorial-section-desc">
              根据套餐价格、线路类型、节点覆盖、客户端支持及不同使用场景整理（含专属优惠信息）。
            </p>
          </div>

          <!-- 纵向排行榜列表 -->
          <div class="editorial-ranking-list">
            {airports.map((ap) => (
              <article class="editorial-row-item">
                <!-- 中间：核心信息区域 -->
                <div class="editorial-main-col">
                  
                  <!-- 品牌名称与英文名 -->
                  <div class="editorial-title-row">
                    <h3 class="editorial-brand-name">
                      <a href={ap.reviewUrl}>{ap.name}</a>
                    </h3>
                    {ap.enName && <span class="editorial-en-name">{ap.enName}</span>}
                    {ap.promoNote && <span class="editorial-promo-pill">{ap.promoNote}</span>}
                  </div>

                  <!-- 一句核心定位 -->
                  <p class="editorial-tagline">{ap.tagline}</p>

                  <!-- 核心参数横向排列 (无边框表格) -->
                  <div class="editorial-params-inline">
                    <span class="param-strong">{ap.price}</span>
                    <span class="param-sep">·</span>
                    <span>{ap.traffic}</span>
                    <span class="param-sep">·</span>
                    <span>{ap.lineType}</span>
                    <span class="param-sep">·</span>
                    <span>{ap.protocol}</span>
                  </div>

                  <!-- 能力标签 -->
                  <div class="editorial-tags-row">
                    {ap.tags.map((tag) => (
                      <span class="editorial-tag-chip">{tag}</span>
                    ))}
                  </div>

                </div>

                <!-- 右侧：行动点 CTA -->
                <div class="editorial-actions-col">
                  <a href={ap.reviewUrl} class="editorial-cta-primary">
                    查看详细评测 →
                  </a>
                  <a
                    href={ap.affUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="editorial-cta-secondary"
                  >
                    官网 ↗
                  </a>
                </div>

              </article>
            ))}
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 02 / 全景参数与线路对比 (17 大品牌) -->
        <section class="editorial-section" id="comparison">
          <div class="section-header-wrap">
            <span class="section-badge-tag">02 / COMPARISON</span>
            <h2 class="editorial-section-title">17 大主流机场参数与线路全景对比</h2>
            <p class="editorial-section-desc">
              一表看清各家服务商在开业时间、价格类型、线路架构与主要推荐定位上的核心差异。
            </p>
          </div>

          <div class="table-responsive-wrapper">
            <table class="editorial-table">
              <thead>
                <tr>
                  <th>品牌名称</th>
                  <th>开业年份</th>
                  <th>入门价格</th>
                  <th>基础流量</th>
                  <th>价格类型</th>
                  <th>核心线路 / 协议</th>
                  <th>主要推荐定位</th>
                  <th>官网入口</th>
                </tr>
              </thead>
              <tbody>
                {fullComparisonAirports.map((ap) => (
                  <tr>
                    <td class="td-brand">
                      <strong>{ap.name}</strong>
                    </td>
                    <td>{ap.year}年</td>
                    <td class="td-price">{ap.price}</td>
                    <td>{ap.traffic}</td>
                    <td><span class="td-type-pill">{ap.type}</span></td>
                    <td>{ap.line}</td>
                    <td><span class="td-pos-tag">{ap.pos}</span></td>
                    <td class="td-action">
                      <a href={ap.affUrl} target="_blank" rel="noopener noreferrer" class="table-text-link">访问官网 ↗</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 03 / 按使用场景精准选型 -->
        <section class="editorial-section" id="scenarios">
          <div class="section-header-wrap">
            <span class="section-badge-tag">03 / SCENARIOS</span>
            <h2 class="editorial-section-title">按使用场景精准选型</h2>
            <p class="editorial-section-desc">
              根据你的核心需求与预算，快速定位最合适的产品方案。
            </p>
          </div>

          <div class="scenarios-editorial-grid">
            <div class="scenario-item">
              <h4 class="scenario-title">ChatGPT & AI 生产力</h4>
              <p class="scenario-desc">
                需要原生住宅 IP、稳定不过期的长连接，杜绝频繁报错降级。
              </p>
              <div class="scenario-footer">
                <span class="recom-label">推荐：</span>
                <span class="recom-text">光速云 · 速界</span>
              </div>
            </div>

            <div class="scenario-item">
              <h4 class="scenario-title">Netflix / 4K 高清流媒体</h4>
              <p class="scenario-desc">
                需要大带宽、低丢包，支持 4K/8K 视频秒开与全地区非自制剧解锁。
              </p>
              <div class="scenario-footer">
                <span class="recom-label">推荐：</span>
                <span class="recom-text">光速云 · 唯兔云</span>
              </div>
            </div>

            <div class="scenario-item">
              <h4 class="scenario-title">超低预算 / 轻度查资料</h4>
              <p class="scenario-desc">
                流量需求约 50GB，追求 IEPL 专线与极低年付均价（约 7 元/月）。
              </p>
              <div class="scenario-footer">
                <span class="recom-label">推荐：</span>
                <span class="recom-text">微风网络 · 飞猫云</span>
              </div>
            </div>

            <div class="scenario-item">
              <h4 class="scenario-title">月付大流量 / 备用防失联</h4>
              <p class="scenario-desc">
                每月需要 150GB 流量或需要 0 月租不限时备用流量包。
              </p>
              <div class="scenario-footer">
                <span class="recom-label">推荐：</span>
                <span class="recom-text">灵猫网络 · 星岛梦</span>
              </div>
            </div>
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 04 / 知识库精选通道 -->
        <section class="editorial-section" id="knowledge">
          <div class="section-header-wrap">
            <span class="section-badge-tag">04 / KNOWLEDGE BASE</span>
            <h2 class="editorial-section-title">机场梯子知识库 & 客户端教程</h2>
            <p class="editorial-section-desc">
              完整的客户端安装、订阅导入、TUN 模式配置与故障排查技术手册。
            </p>
          </div>

          <div class="kb-editorial-grid">
            <a href="/reviews/guangsu-cloud/" class="kb-editorial-card">
              <span class="kb-topic-tag">旗舰评测</span>
              <h4 class="kb-item-title">光速云深度评测：2020老牌IEPL专线实测</h4>
              <p class="kb-item-desc">晚高峰千兆跑分、VLESS 协议与 ChatGPT 解锁实测数据。</p>
              <span class="kb-arrow-cta">阅读评测 →</span>
            </a>

            <a href="/reviews/weifeng-cloud/" class="kb-editorial-card">
              <span class="kb-topic-tag">超低价专线</span>
              <h4 class="kb-item-title">微风网络评测：约7元/月IEPL轻度专线</h4>
              <p class="kb-item-desc">50GB 小流量轻度办公、自研客户端与 9 折优惠码实测。</p>
              <span class="kb-arrow-cta">阅读评测 →</span>
            </a>

            <a href="/wiki/what-is-clash/" class="kb-editorial-card">
              <span class="kb-topic-tag">新手入门</span>
              <h4 class="kb-item-title">Clash 是什么？新手完整使用指南</h4>
              <p class="kb-item-desc">搞懂规则分流、节点配置与代理模式核心原理。</p>
              <span class="kb-arrow-cta">阅读指南 →</span>
            </a>

            <a href="/tutorials/clash-verge-rev/" class="kb-editorial-card">
              <span class="kb-topic-tag">客户端教程</span>
              <h4 class="kb-item-title">Clash Verge Rev 下载与安装教程</h4>
              <p class="kb-item-desc">Windows/macOS 平台最主流的 Clash 客户端配置实战。</p>
              <span class="kb-arrow-cta">阅读指南 →</span>
            </a>
          </div>

          <div class="kb-bottom-cta">
            <a href="/blog/" class="editorial-hub-link">
              前往「知识库」浏览全部 28 篇深度评测与使用手册 ⇗
            </a>
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 05 / 常见选购 FAQ -->
        <section class="editorial-section" id="faq">
          <div class="section-header-wrap">
            <span class="section-badge-tag">05 / FAQ</span>
            <h2 class="editorial-section-title">机场选购常见问答</h2>
            <p class="editorial-section-desc">
              解答新手在挑选机场时最关心的稳定度、年付/月付选择与优惠码使用方式。
            </p>
          </div>

          <div class="faq-editorial-list">
            <details class="faq-editorial-item" open>
              <summary class="faq-editorial-q">光速云与微风网络、飞猫云有什么区别？分别适合谁？</summary>
              <p class="faq-editorial-a">
