  { name: '二猫云', year: '2023', price: '20 元/月', traffic: '130GB', type: '月付', line: 'VLESS / IEPL', pos: '20元中等流量', affUrl: 'https://guangs.2maoyunaff.cc/#/?code=7mjvgGbW' },
