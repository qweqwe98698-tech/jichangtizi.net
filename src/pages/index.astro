// 17 个机场品牌全景对比摘要数据
const fullComparisonAirports = [
  { name: '光速云', year: '2020', price: '约 7.5~8 元/月', traffic: '59G~238G', type: '年付折算/月付', line: 'IEPL / 全球 IPLC / VLESS', pos: '老牌旗舰综合型', affUrl: 'https://sahude.gsyvipaff.com/#/?code=keqgvT5Y' },
  { name: '微风网络', year: '2023', price: '约 7 元/月', traffic: '50GB', type: '年付折算', line: 'IEPL 专线', pos: '低价轻度专线', affUrl: 'https://edp01.breezenetaff.com/#/?code=R9ZazSfE' },
  { name: '飞猫云', year: '2023', price: '约 7 元/月', traffic: '50GB', type: '年付折算', line: 'IEPL 专线', pos: '低价轻度用户', affUrl: 'https://guangs.flycataff.com/#/?code=6uq0Xe9y' },
  { name: '星岛梦', year: '2020', price: '约 8 元/月', traffic: '60GB', type: '年付折算', line: '企业级内网专线', pos: '低价长期/不限时', affUrl: 'https://guangs.xingdaomeng.com/#/?code=1TynBYnR' },
  { name: '唯兔云', year: '2023', price: '14.9 元/月', traffic: '100GB', type: '月付', line: 'VLESS / 60+节点', pos: '节点丰富/三网优化', affUrl: 'https://guangs.v2yunvipaff.com/#/?code=xIutqOBA' },
  { name: '宇宙云', year: '2023', price: '14.9 元/月', traffic: '100GB', type: '月付', line: 'VLESS / IEPL', pos: '15元性价比', affUrl: 'https://guangs.yuzoucloud.cc/#/register?code=yrThwMP1' },
  { name: '极连云', year: '2024', price: '18 元/月', traffic: '100GB', type: '月付', line: 'IEPL 专线', pos: '20元内综合型', affUrl: 'https://guangs.jlyvipaff.com/#/?code=VM1rKGUu' },
  { name: '光年梯', year: '2025', price: '18 元/月', traffic: '110GB', type: '月付', line: 'VLESS / IEPL', pos: '18元综合专线', affUrl: 'https://guangs.gntaff.com/#/?code=X1FoxjGE' },
  { name: '灵猫网络', year: '2024', price: '19 元/月', traffic: '150GB', type: '月付', line: '企业级内网专线', pos: '月付大流量', affUrl: 'https://vip01.civetnet.com/#/?code=8MIAyxak' },
