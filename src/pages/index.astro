>
  <HeroHeader
    text={homeHero.text}
    subtitle={homeHero.subtitle}
    backgroundImage={homeHero.backgroundImage}
    interactive={true}
  />

  <div class="stats-wrapper">
    <ContentCard id="stats-card">
      <div class="editorial-home-container">
        
        <!-- 01 / RECOMMENDED 编辑部精选机场列表 (纵向杂志式排行榜) -->
        <section class="editorial-ranking-section" id="ranking">
          <div class="section-header-wrap">
            <span class="section-badge-tag">01 / RECOMMENDED</span>
            <h2 class="editorial-section-title">2026 精选机场推荐</h2>
            <p class="editorial-section-desc">
              根据套餐价格、线路类型、节点覆盖、客户端支持及不同使用场景整理（含专属优惠信息）。
            </p>
          </div>

          <!-- 纵向排行榜列表 -->
          <div class="editorial-ranking-list">
            {airports.map((ap) => (
              <article class="editorial-row-item">
                <!-- 中间：核心信息区域 -->
                <div class="editorial-main-col">
                  
                  <!-- 品牌名称与英文名 -->
                  <div class="editorial-title-row">
                    <h3 class="editorial-brand-name">
                      <a href={ap.reviewUrl}>{ap.name}</a>
                    </h3>
                    {ap.enName && <span class="editorial-en-name">{ap.enName}</span>}
                    {ap.promoNote && <span class="editorial-promo-pill">{ap.promoNote}</span>}
                  </div>

                  <!-- 一句核心定位 -->
                  <p class="editorial-tagline">{ap.tagline}</p>

                  <!-- 核心参数横向排列 (无边框表格) -->
                  <div class="editorial-params-inline">
                    <span class="param-strong">{ap.price}</span>
                    <span class="param-sep">·</span>
                    <span>{ap.traffic}</span>
                    <span class="param-sep">·</span>
                    <span>{ap.lineType}</span>
                    <span class="param-sep">·</span>
                    <span>{ap.protocol}</span>
                  </div>

                  <!-- 能力标签 -->
                  <div class="editorial-tags-row">
                    {ap.tags.map((tag) => (
                      <span class="editorial-tag-chip">{tag}</span>
                    ))}
                  </div>

                </div>

                <!-- 右侧：行动点 CTA -->
                <div class="editorial-actions-col">
                  <a href={ap.reviewUrl} class="editorial-cta-primary">
                    查看详细评测 →
                  </a>
                  <a
                    href={ap.affUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="editorial-cta-secondary"
                  >
                    官网 ↗
                  </a>
                </div>

              </article>
            ))}
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 02 / 全景参数与线路对比 (42 大品牌) -->
        <section class="editorial-section" id="comparison">
          <div class="section-header-wrap">
            <span class="section-badge-tag">02 / COMPARISON</span>
            <h2 class="editorial-section-title">42 大主流机场参数与线路全景对比</h2>
            <p class="editorial-section-desc">
              一表看清 2026 年 42 家主流机场在开业年份、起步价格、线路架构（IEPL专线/隧道/BGP中转/直连）、协议支持与核心定位上的差异。
            </p>
          </div>

          <div class="table-responsive-wrapper">
            <table class="editorial-table">
              <thead>
                <tr>
                  <th>品牌名称</th>
                  <th>开业年份</th>
                  <th>入门价格</th>
                  <th>基础流量</th>
                  <th>价格类型</th>
                  <th>核心线路 / 协议</th>
                  <th>主要推荐定位</th>
                  <th>官网入口</th>
                </tr>
              </thead>
              <tbody>
                {fullComparisonAirports.map((ap) => (
                  <tr>
                    <td class="td-brand">
                      <strong>{ap.name}</strong>
                    </td>
                    <td>{ap.year}年</td>
                    <td class="td-price">{ap.price}</td>
                    <td>{ap.traffic}</td>
                    <td><span class="td-type-pill">{ap.type}</span></td>
                    <td>{ap.line}</td>
                    <td><span class="td-pos-tag">{ap.pos}</span></td>
                    <td class="td-action">
                      <a href={ap.affUrl} target="_blank" rel="nofollow sponsored noopener" class="table-text-link">访问官网 ↗</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 03 / 按使用场景精准选型 -->
        <section class="editorial-section" id="scenarios">
          <div class="section-header-wrap">
            <span class="section-badge-tag">03 / SCENARIOS</span>
            <h2 class="editorial-section-title">按终端与使用场景精准选型</h2>
            <p class="editorial-section-desc">
              根据您的终端设备（手机/电脑）、核心需求（AI/流媒体/办公）与预算，快速定位最匹配的梯子方案。
            </p>
          </div>

          <div class="scenarios-editorial-grid">
            <div class="scenario-item">
              <h4 class="scenario-title">📱 手机端科学上网 (iOS / 安卓)</h4>
              <p class="scenario-desc">
                注重 5G/Wi-Fi 智能切换不掉线、后台省电防杀进程与小火箭/v2rayNG 一键导入。
              </p>
              <div class="scenario-footer">
                <a href="/recommend/mobile-tizi/" class="table-text-link">查看手机梯子选型指南 →</a>
              </div>
            </div>

            <div class="scenario-item">
              <h4 class="scenario-title">💻 电脑桌面端 (Windows / Mac)</h4>
              <p class="scenario-desc">
                注重 Clash Verge Rev / TUN 虚拟网卡接管、终端开发与系统代理稳定性。
              </p>
              <div class="scenario-footer">
                <a href="/recommend/pc-tizi/" class="table-text-link">查看电脑梯子配置指南 →</a>
              </div>
            </div>

            <div class="scenario-item">
              <h4 class="scenario-title">🤖 ChatGPT & AI 生产力专线</h4>
              <p class="scenario-desc">
                需要原生住宅 IP、稳定不过期的长连接，杜绝频繁报错降级与账号风控。
              </p>
              <div class="scenario-footer">
                <a href="/recommend/which-tizi-is-best/" class="table-text-link">查看梯子软件横向对比 →</a>
              </div>
            </div>

            <div class="scenario-item">
              <h4 class="scenario-title">🆓 免费体验 / 应急断网备用</h4>
              <p class="scenario-desc">
                大厂官方 1 元试用与小额流量包，突发断网救急与本地网络测速首选。
              </p>
              <div class="scenario-footer">
                <a href="/wiki/free-tizi/" class="table-text-link">查看免费体验与避坑指南 →</a>
              </div>
            </div>
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 04 / 知识库精选通道 -->
        <section class="editorial-section" id="knowledge">
          <div class="section-header-wrap">
            <span class="section-badge-tag">04 / KNOWLEDGE BASE</span>
            <h2 class="editorial-section-title">核心知识库 & 客户端教程</h2>
            <p class="editorial-section-desc">
              覆盖梯子基础科普、Clash Verge Rev、Shadowrocket 小火箭与网络故障排查。
            </p>
          </div>

          <div class="kb-editorial-grid">
            <a href="/wiki/what-is-tizi/" class="kb-editorial-card">
              <span class="kb-topic-tag">基础科普</span>
              <h4 class="kb-item-title">梯子是什么？梯子与VPN/机场区别</h4>
              <p class="kb-item-desc">零基础搞懂客户端、节点、订阅链接与物理专线层级关系。</p>
              <span class="kb-arrow-cta">阅读科普 →</span>
            </a>

            <a href="/tutorials/clash-verge-rev/" class="kb-editorial-card">
              <span class="kb-topic-tag">电脑客户端</span>
              <h4 class="kb-item-title">Clash Verge Rev 电脑下载与配置教程</h4>
              <p class="kb-item-desc">Windows/Mac 订阅导入、系统代理与 TUN 模式一站式搞定。</p>
              <span class="kb-arrow-cta">阅读指南 →</span>
            </a>

            <a href="/tutorials/shadowrocket-nodes/" class="kb-editorial-card">
              <span class="kb-topic-tag">手机客户端</span>
              <h4 class="kb-item-title">Shadowrocket 小火箭节点怎么选？</h4>
              <p class="kb-item-desc">香港/日本/美国节点延迟对比、线路选择与晚高峰决策树。</p>
              <span class="kb-arrow-cta">阅读指南 →</span>
            </a>

            <a href="/recommend/which-tizi-is-best/" class="kb-editorial-card">
              <span class="kb-topic-tag">选型对比</span>
              <h4 class="kb-item-title">梯子软件哪个好用？测速与稳定性对比</h4>
              <p class="kb-item-desc">主流梯子软件多维度横向实测，提供各场景决策清单。</p>
              <span class="kb-arrow-cta">阅读对比 →</span>
            </a>
          </div>

          <div class="kb-bottom-cta">
            <a href="/blog/" class="editorial-hub-link">
              前往「知识库」浏览全部 100+ 篇深度评测与使用手册 ⇗
            </a>
          </div>
        </section>

        <div class="editorial-divider"></div>

        <!-- 05 / 常见选购 FAQ -->
        <section class="editorial-section" id="faq">
          <div class="section-header-wrap">
            <span class="section-badge-tag">05 / FAQ</span>
            <h2 class="editorial-section-title">机场选购常见问答</h2>
            <p class="editorial-section-desc">
              解答新手在挑选机场时最关心的稳定度、年付/月付选择与优惠码使用方式。
            </p>
          </div>

          <div class="faq-editorial-list">
            <details class="faq-editorial-item" open>
              <summary class="faq-editorial-q">光速云与微风网络、飞猫云有什么区别？分别适合谁？</summary>
              <p class="faq-editorial-a">
                <strong>光速云</strong>属于 2020 年老牌综合型旗舰，提供 IPLC/IEPL 全球大带宽专线与原生住宅 IP，适合对 ChatGPT、Netflix 4K 及大流量有高要求的用户；<strong>微风网络</strong>与<strong>飞猫云</strong>主打 IEPL 小流量年付极致性价比（约 7 元/月，50GB），更适合日常查资料、收发邮件和轻度学术用户。
              </p>
            </details>

            <details class="faq-editorial-item">
              <summary class="faq-editorial-q">购买机场套餐时，年付折算价格和普通月付有什么区别？</summary>
              <p class="faq-editorial-a">
                年付折算价（如微风网络与飞猫云约 7 元/月、光速云约 7.5~8 元/月）指购买一年套餐后的平均每月花费，需要一次性支付整年费用；月付价（如唯兔云 14.9 元、U1S1 20 元）则是按单月付费，灵活性更高。
              </p>
            </details>

            <details class="faq-editorial-item">
              <summary class="faq-editorial-q">优惠码应该在哪里输入？</summary>
              <p class="faq-editorial-a">
                进入机场官网注册并选定套餐后，在结算付款页面找到“优惠券/折扣码”输入框（例如光速云输入 <code>AMM</code> 享 8 折，微风网络输入 <code>flat888</code> 享 9 折，飞猫云输入 <code>flycat888</code> 享 8 折），点击应用后即可减免对应金额。
              </p>
            </details>
          </div>
        </section>

      </div>
    </ContentCard>
  </div>
</PageShell>

<style>
  /* 整体容器与卡片浮动 */
  .stats-wrapper {
    position: relative;
    width: 100%;
  }

  .editorial-home-container {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 22px;
    padding: clamp(2em, 4vw, 3.5em);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    max-width: 1160px;
    margin: 0 auto;
  }

  .section-header-wrap {
    margin-bottom: 2em;
  }

  .section-badge-tag {
    display: inline-block;
    font-size: 0.76em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2em 0.6em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    margin-bottom: 0.6em;
  }

  .editorial-section-title {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 800;
    color: var(--color-text-strong);
    margin: 0 0 0.4em 0;
    letter-spacing: -0.01em;
  }

  .editorial-section-desc {
    font-size: 0.94em;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .editorial-divider {
    height: 1px;
    background: var(--color-border-subtle);
    margin: 3.5em 0;
  }

  /* 01 / 杂志式排行榜列表 */
  .editorial-ranking-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-row-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: 1.8em;
    align-items: center;
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.2s ease;
  }

  .editorial-row-item:first-child {
    padding-top: 6px;
  }

  .editorial-row-item:last-child {
    border-bottom: none;
    padding-bottom: 6px;
  }

  /* 核心信息区 */
  .editorial-main-col {
    display: flex;
    flex-direction: column;
    gap: 0.45em;
  }

  .editorial-title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  .editorial-brand-name {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .editorial-brand-name a {
    color: var(--color-text-strong);
    text-decoration: none;
    transition: color 0.2s;
  }

  .editorial-brand-name a:hover {
    color: var(--accent);
  }

  .editorial-en-name {
    font-size: 0.88rem;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .editorial-promo-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: #10b981;
    background: color-mix(in srgb, #10b981 12%, transparent);
    padding: 0.15em 0.55em;
    border-radius: 4px;
  }

  .editorial-tagline {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* 参数横向排列 (无表格框) */
  .editorial-params-inline {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-top: 0.2em;
  }

  .param-strong {
    font-weight: 700;
    color: var(--color-text-strong);
  }

  .param-sep {
    color: var(--color-text-muted);
  }

  /* 能力标签 */
  .editorial-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-top: 0.3em;
  }

  .editorial-tag-chip {
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-subtle);
    padding: 0.2em 0.55em;
    border-radius: 4px;
  }

  /* 行动点 CTA */
  .editorial-actions-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5em;
  }

  .editorial-cta-primary {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease, text-decoration 0.2s;
  }

  .editorial-cta-primary:hover {
    transform: translateX(3px);
    text-decoration: underline;
  }

  .editorial-cta-secondary {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .editorial-cta-secondary:hover {
    color: var(--color-text-strong);
  }

  /* 02 / 对比表格 */
  .table-responsive-wrapper {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border-subtle);
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .editorial-table th,
  .editorial-table td {
    padding: 0.95em 1.1em;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .editorial-table th {
    background: var(--color-surface-elevated);
    font-weight: 700;
    color: var(--color-text-strong);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .td-brand {
    white-space: nowrap;
  }

  .td-price {
    font-weight: 700;
    color: var(--color-text-strong);
    white-space: nowrap;
  }

  .td-type-pill {
    font-size: 0.78em;
    padding: 0.15em 0.5em;
    border-radius: 4px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
  }

  .td-pos-tag {
    font-size: 0.85em;
    color: var(--accent);
    font-weight: 600;
  }

  .table-text-link {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .table-text-link:hover {
    text-decoration: underline;
  }

  /* 03 / 场景指南网格 */
  .scenarios-editorial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2em;
  }

  .scenario-item {
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 12px;
    padding: 1.4em;
    display: flex;
    flex-direction: column;
  }

  .scenario-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-strong);
    margin: 0 0 0.4em 0;
  }

  .scenario-desc {
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 1em 0;
  }

  .scenario-footer {
    font-size: 0.82rem;
    margin-top: auto;
  }

  .recom-label {
    color: var(--color-text-tertiary);
  }

  .recom-text {
    font-weight: 600;
    color: var(--accent);
  }

  /* 04 / 知识库入口 */
  .kb-editorial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2em;
  }

  .kb-editorial-card {
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 12px;
    padding: 1.4em;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }

  .kb-editorial-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .kb-topic-tag {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5em;
  }

  .kb-item-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-strong);
    margin: 0 0 0.4em 0;
    line-height: 1.4;
  }

  .kb-item-desc {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 1em 0;
  }

  .kb-arrow-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: auto;
  }

  .kb-bottom-cta {
    margin-top: 1.8em;
    text-align: center;
  }

  .editorial-hub-link {
    display: inline-block;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text-strong);
    padding: 0.7em 1.6em;
    border-radius: 8px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 0.2s;
  }

  .editorial-hub-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  /* 05 / FAQ */
  .faq-editorial-list {
    display: flex;
    flex-direction: column;
    gap: 0.8em;
  }

  .faq-editorial-item {
    background: var(--color-surface-elevated);
