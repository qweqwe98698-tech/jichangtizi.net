---
import type { GetStaticPaths, Page } from 'astro';
import ContentCard from '../../components/ContentCard.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import PageShell from '../../layouts/PageShell.astro';
import PostListItem from '../../components/PostListItem.astro';
import { heroConfig, siteTitle, siteUrl } from '../../config';
import { getBlogPosts, type BlogPost } from '../../lib/content/blog';
import {
  getBlogPageParam,
  getBlogPagePath,
  getBlogPageUrls,
} from '../../lib/content/blog-page-path';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getBlogPosts();

  if (posts.length === 0) {
    return [
      {
        params: { page: undefined },
        props: {
          page: {
            data: [],
            start: 0,
            end: 0,
            size: 15,
            total: 0,
            currentPage: 1,
            lastPage: 1,
            url: getBlogPageUrls(1, 1),
          },
        },
      },
    ];
  }

  return paginate(posts, { pageSize: 15 }).map((entry) => {
    const currentPage = entry.props.page.currentPage;
    const lastPage = entry.props.page.lastPage;
    return {
      ...entry,
      params: {
        ...entry.params,
        page: getBlogPageParam(currentPage),
      },
      props: {
        ...entry.props,
        page: {
          ...entry.props.page,
          url: getBlogPageUrls(currentPage, lastPage),
        },
      },
    };
  });
};

const { page } = Astro.props as { page: Page<BlogPost> };
const hasPosts = page.total > 0;
const blogHero = heroConfig.blog;

const pageTitle =
  page.currentPage === 1
    ? `机场梯子知识库：机场推荐、Clash教程、节点订阅与网络问题解决 · ${siteTitle}`
    : `知识库 - 第 ${page.currentPage} 页 · ${siteTitle}`;

const pageDescription =
  '机场梯子知识库持续整理机场推荐、机场评测、Clash、Mihomo、Clash Verge Rev、节点订阅、线路协议、客户端教程及常见问题解决方案。';

const shouldNoindex = page.currentPage > 1;
const canonicalPath = getBlogPagePath(page.currentPage);
const canonicalURL = new URL(canonicalPath, siteUrl).toString();
const prevURL = page.url.prev ? new URL(page.url.prev, siteUrl).toString() : undefined;
const nextURL = page.url.next ? new URL(page.url.next, siteUrl).toString() : undefined;

// 8 大核心知识分类
const categories = [
  {
    title: '机场推荐',
    tag: '机场推荐',
    href: '/tags/机场推荐/',
    desc: '稳定机场、性价比机场、AI机场与不同需求选择指南。',
    count: '精选',
  },
  {
    title: '机场评测',
    tag: '机场评测',
    href: '/tags/机场推荐/',
    desc: '品牌套餐、线路、节点、客户端支持与风险状态。',
    count: '实测',
  },
  {
    title: 'Clash / Mihomo',
    tag: 'Clash',
    href: '/tags/clash/',
    desc: 'Clash Verge Rev、Mihomo、TUN、DNS和规则教程。',
    count: '核心',
  },
  {
    title: '节点与订阅',
    tag: '节点订阅',
    href: '/tags/节点订阅/',
    desc: '订阅导入、节点测速、订阅更新和配置文件。',
    count: '指南',
  },
  {
    title: '客户端教程',
    tag: '客户端教程',
    href: '/tags/客户端教程/',
    desc: 'Windows、Android、macOS、iOS 常用客户端教程。',
    count: '教程',
  },
  {
    title: '线路与协议',
    tag: '线路协议',
    href: '/tags/线路协议/',
    desc: 'IEPL、IPLC、中转、直连、VLESS、Trojan、Hysteria2。',
    count: '原理',
  },
  {
    title: '问题解决',
    tag: '问题解决',
    href: '/tags/问题解决/',
    desc: '无法连接、Timeout、DNS异常、客户端错误等。',
    count: '排查',
  },
  {
    title: '风险数据库',
    tag: '风险预警',
    href: '/tags/风险预警/',
    desc: '机场失联、域名变化、停止运营及异常事件。',
    count: '预警',
  },
];

// 热门专题 Pillar 标签
const hotPillars = [
  { title: '2026机场推荐', href: '/tags/机场推荐/' },
  { title: 'Clash Verge Rev', href: '/tags/clash/' },
  { title: 'Mihomo', href: '/tags/mihomo/' },
  { title: '机场订阅', href: '/tags/节点订阅/' },
  { title: 'AI工具', href: '/tags/机场推荐/' },
  { title: '流媒体', href: '/tags/机场推荐/' },
  { title: '机场风险', href: '/tags/风险预警/' },
];

// 核心 FAQ 问答
const hotFaqs = [
  {
    q: '2026 年新手选购机场的核心原则是什么？',
    a: '① 坚持月付，拒绝 2 年以上长约；② 优先选运营 3 年以上老牌大厂；③ 认准不过 GFW 的 IEPL 纯内网专线；④ 常备按量计费备用节点。',
    link: '/recommend/best-airports/',
    linkText: '阅读完整推荐指南 →',
  },
  {
    q: 'Clash 怎么导入机场订阅链接？',
    a: '在机场后台复制 Clash 订阅链接，打开 Clash Verge Rev 进入“订阅”页面，粘贴并点击“导入”，随后右键选中该配置并开启“系统代理”。',
    link: '/tutorials/clash-subscription-import/',
    linkText: '查看导入图文步骤 →',
  },
  {
    q: 'Clash 节点显示绿色延迟但打不开网页怎么办？',
    a: '请依次检查：① 电脑系统时间是否与北京时间精准同步（误差超 60 秒会导致 TLS 握手失败）；② 代理模式是否切换为“规则 (Rule)”；③ 手动选定具体可用节点。',
    link: '/issues/clash-connected-no-internet/',
    linkText: '查看 7 步排查手册 →',
  },
  {
    q: 'Mihomo 和原版 Clash 到底有什么区别？',
    a: 'Mihomo 是社区活跃维护的分支内核，全面支持 VLESS-Reality、Hysteria 2、TUIC 等新一代抗封锁协议，并提供更强的 TUN 虚拟网卡与 DNS 防污染能力。',
    link: '/wiki/mihomo-vs-clash/',
    linkText: '阅读内核深度对比 →',
  },
  {
    q: 'Clash TUN 模式和普通系统代理有什么区别？',
    a: '系统代理仅对遵循系统设置的浏览器等软件生效；TUN 模式是在系统网络层创建虚拟网卡接管所有流量（包含命令行终端、Git、Docker 和外服游戏 UDP 流量）。',
    link: '/wiki/clash-tun-mode-vs-system-proxy/',
    linkText: '了解 TUN 模式配置 →',
  },
  {
    q: '为什么机场节点延迟很低（30ms）但看视频却卡顿？',
    a: 'Ping 延迟只代表往返物理时间，不代表带宽吞吐量。低价机场晚高峰严重超售会导致带宽拥堵，建议避开扎堆香港节点或选择大带宽专线。',
    link: '/issues/low-ping-slow-speed-reasons/',
    linkText: '查看测速与拥堵分析 →',
  },
  {
    q: '机场跑路前通常有哪些反常信号？',
    a: '突发上线超低价 3 折终身套餐、TG 官方频道突然全员禁言或批量踢人、收银台频繁更换个人收款码、节点大面积爆红数周无人修复。',
    link: '/risk/airport-running-away-warning-signs/',
    linkText: '查看避坑保命法则 →',
  },
];

// Schema.org 结构化数据 (CollectionPage + ItemList + BreadcrumbList)
const blogSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'zh-CN',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        url: siteUrl,
        name: siteTitle,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: '首页',
            item: siteUrl,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: '知识库',
            item: `${siteUrl}/blog/`,
          },
        ],
      },
    },
    {
      '@type': 'ItemList',
      '@id': `${canonicalURL}#itemlist`,
      name: '机场梯子知识库最新文章列表',
      numberOfItems: page.data.length,
      itemListElement: page.data.map((post, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: post.data.title,
        url: new URL(`/blog/${post.id}/`, siteUrl).toString(),
      })),
    },
  ],
};

// 分页逻辑
const current = page.currentPage;
const last = page.lastPage;
const delta = 2;
const paginationList: Array<number | '...'> = [];
const rangeStart = Math.max(2, current - delta);
const rangeEnd = Math.min(last - 1, current + delta);

paginationList.push(1);
if (rangeStart > 2) paginationList.push('...');
for (let i = rangeStart; i <= rangeEnd; i += 1) paginationList.push(i);
if (rangeEnd < last - 1) paginationList.push('...');
if (last > 1) paginationList.push(last);
---

<PageShell
  title={pageTitle}
  description={pageDescription}
  noindex={shouldNoindex}
  canonical={canonicalURL}
  prevURL={prevURL}
  nextURL={nextURL}
  schema={blogSchema}
  transparentHeader={true}
  pageId="blog-list"
>
  <!-- 顶部 Hero 巨幕 (森林自然背景 + 标题 + 交互搜索框) -->
  <HeroHeader
    text={blogHero.text}
    subtitle={blogHero.subtitle}
    backgroundImage={blogHero.backgroundImage}
    compact={true}
  >
    <p class="hero-desc-note">
      从机场怎么选，到客户端怎么配置，再到连接异常怎么排查，在这里找到对应答案。
    </p>

    <!-- 真实 Pagefind 搜索触发栏 -->
    <div class="hero-search-box-wrap">
      <button id="hero-pagefind-btn" class="hero-search-bar" type="button" aria-label="搜索知识库">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <span class="search-placeholder-text">搜索机场、Clash、订阅、节点或使用问题...</span>
        <span class="search-key-hint">/</span>
      </button>
    </div>
  </HeroHeader>

  <!-- 主体浮动卡片容器 -->
  <div class="stats-wrapper">
    <ContentCard id="stats-card" floating={true} class="knowledge-card-wrapper">
      <div class="knowledge-container">
        
        <!-- 一、分类导航区 (8 大核心分类卡片) -->
        <section class="kb-section" id="categories">
          <div class="section-badge-row">
            <span class="section-tag">01 / 分类索引</span>
          </div>
          <h2 class="section-title">浏览知识分类</h2>
          <p class="section-subtitle">按专业维度探索系统化知识库与专题教程</p>

          <div class="categories-grid">
            {categories.map((cat) => (
              <a href={cat.href} class="category-card">
                <div class="cat-card-header">
                  <span class="cat-badge">{cat.count}</span>
                  <span class="cat-arrow">↗</span>
                </div>
                <h3 class="cat-title">{cat.title}</h3>
                <p class="cat-desc">{cat.desc}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- 二、热门专题 (Pillars) -->
        <div class="pillars-bar-wrap">
          <span class="pillars-label">热门专题：</span>
          <div class="pillars-list">
            {hotPillars.map((p) => (
              <a href={p.href} class="pillar-pill">{p.title}</a>
            ))}
          </div>
        </div>

        <div class="kb-divider"></div>

        <!-- 三、最新指南与文章列表 (与首页截图 100% 相同的高级原生列表) -->
        <section class="kb-section" id="articles">
          <div class="section-badge-row">
            <span class="section-tag">02 / 文章列表</span>
          </div>
          <h2 class="section-title">全部知识库指南</h2>
          <p class="section-subtitle">持续更新机场评测、客户端教程、节点订阅、线路知识和常见问题解决方案。</p>

          {hasPosts ? (
            <div class="home-posts-list">
              {page.data.map((post) => (
                <PostListItem
                  post={post}
                  titleTag="h3"
                  articleClass="home-post-item"
                  titleClass="home-post-title"
                  showExcerpt={false}
                  metaContainerClass="home-post-meta"
                  metaItemClass="home-post-meta-item"
                  metaTagsClass="home-post-tags"
                  tagLinkClass="home-tag-link hover-scale"
                  tagLimit={4}
                />
              ))}
            </div>
          ) : (
            <div class="empty-state-box">
              <p>知识库正在整理更新中，敬请期待。</p>
            </div>
          )}

          <!-- 分页控制器 (只在文章列表底部展示) -->
          {last > 1 && (
            <nav class="pagination-nav" aria-label="文章分页导航">
              {page.url.prev ? (
                <a href={page.url.prev} class="page-arrow-btn">← 上一页</a>
              ) : (
                <span class="page-arrow-btn disabled">← 上一页</span>
              )}

              <div class="page-numbers-list">
                {paginationList.map((item) => {
                  if (item === '...') {
                    return <span class="page-ellipsis">...</span>;
                  }
                  const pageUrl = getBlogPagePath(item);
                  const isCurrent = item === current;
                  return (
                    <a
                      href={pageUrl}
                      class:list={['page-num-btn', { active: isCurrent }]}
                      aria-current={isCurrent ? 'page' : undefined}
                    >
                      {item}
                    </a>
                  );
                })}
              </div>

              {page.url.next ? (
                <a href={page.url.next} class="page-arrow-btn">下一页 →</a>
              ) : (
                <span class="page-arrow-btn disabled">下一页 →</span>
              )}
            </nav>
          )}
        </section>

        <div class="kb-divider"></div>

        <!-- 四、知识库高频问题解答 (FAQ) -->
        <section class="kb-section" id="faqs">
          <div class="section-badge-row">
            <span class="section-tag">03 / 常见问答</span>
          </div>
          <h2 class="section-title">高频使用问题速查</h2>
          <p class="section-subtitle">从文章与实践中提炼的核心疑问快速解答</p>

          <div class="faq-list-wrap">
            {hotFaqs.map((faq) => (
              <details class="faq-accordion-item">
                <summary class="faq-summary">
                  <span class="faq-question-text">{faq.q}</span>
                  <span class="faq-toggle-icon">+</span>
                </summary>
                <div class="faq-answer-body">
                  <p class="faq-answer-text">{faq.a}</p>
                  {faq.link && (
                    <div class="faq-link-row">
                      <a href={faq.link} class="faq-more-link">{faq.linkText}</a>
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>

      </div>
    </ContentCard>
  </div>
</PageShell>

<script>
  // 绑定 Hero 搜索栏点击触发全局搜索框
  const bindHeroSearch = () => {
    const searchTrigger = document.getElementById('hero-pagefind-btn');
    if (!searchTrigger) return;
    searchTrigger.addEventListener('click', () => {
      const globalSearchBtn = document.getElementById('search-btn');
      if (globalSearchBtn) {
        globalSearchBtn.click();
      }
    });
  };

  bindHeroSearch();
  document.addEventListener('astro:page-load', bindHeroSearch);
</script>

<style>
  /* 整体容器与卡片浮动 */
  .stats-wrapper {
    position: relative;
    width: 100%;
  }

  .knowledge-container {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 22px;
    padding: clamp(1.8em, 4vw, 3em);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
    max-width: 1180px;
    margin: 0 auto;
  }

  /* Hero 描述与搜索框 */
  .hero-desc-note {
    font-size: 1.02em;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.5em;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .hero-search-box-wrap {
    margin-top: 1.4em;
    display: flex;
    justify-content: center;
  }

  .hero-search-bar {
    display: flex;
    align-items: center;
    gap: 0.75em;
    width: min(540px, 92vw);
    padding: 0.75em 1.2em;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    cursor: pointer;
    text-align: left;
    color: #4b5563;
    transition: transform 0.2s, background 0.2s, box-shadow 0.2s;
  }

  :global([data-theme='dark']) .hero-search-bar {
    background: rgba(26, 32, 44, 0.92);
    border-color: rgba(255, 255, 255, 0.15);
    color: #94a3b8;
  }

  .hero-search-bar:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.24);
  }

  .search-placeholder-text {
    flex: 1;
    font-size: 0.92em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-key-hint {
    padding: 0.15em 0.55em;
    border-radius: 6px;
    font-size: 0.75em;
    font-family: var(--font-mono, monospace);
    font-weight: bold;
    background: rgba(0, 0, 0, 0.08);
    color: #6b7280;
  }

  :global([data-theme='dark']) .search-key-hint {
    background: rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
  }

  /* 章节标题 */
  .kb-section {
    margin-top: 0.5em;
  }

  .section-badge-row {
    margin-bottom: 0.5em;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.76em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2em 0.6em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .section-title {
    font-size: 1.5em;
    font-weight: 700;
    color: var(--color-text-strong);
    margin: 0 0 0.3em 0;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-size: 0.95em;
    color: var(--color-text-secondary);
    margin: 0 0 1.8em 0;
    line-height: 1.6;
  }

  .kb-divider {
    height: 1px;
    background: var(--color-border-subtle);
    margin: 3.2em 0 2.6em;
  }

  /* 一、8 大分类网格 */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2em;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    padding: 1.4em;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--color-border-subtle));
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
  }

  .cat-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6em;
  }

  .cat-badge {
    font-size: 0.75em;
    font-weight: 600;
    color: var(--accent);
    padding: 0.15em 0.5em;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .cat-arrow {
    font-size: 1.1em;
    color: var(--color-text-muted);
    transition: transform 0.2s;
  }

  .category-card:hover .cat-arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .cat-title {
    font-size: 1.15em;
    font-weight: 700;
    color: var(--color-text-strong);
    margin: 0 0 0.4em 0;
  }

  .cat-desc {
    font-size: 0.86em;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* 热门专题 Bar */
  .pillars-bar-wrap {
    display: flex;
    flex-wrap: wrap;
