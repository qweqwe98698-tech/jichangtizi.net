---
import ContentCard from '../components/ContentCard.astro';
import HeroHeader from '../components/HeroHeader.astro';
import PageShell from '../layouts/PageShell.astro';
import { heroConfig, siteTitle, siteUrl } from '../config';

const aboutHero = heroConfig.about;
const canonicalUrl = new URL('/about/', siteUrl).toString();

// Schema.org 结构化数据 (AboutPage + Organization + BreadcrumbList)
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: `关于我们 · ${siteTitle}`,
      description: '机场梯子（jichangtizi.net）专注机场推荐、品牌评测、Clash / Mihomo 与网络工具使用指南。建立真实、客观、持续更新的中文网络工具知识库。',
      inLanguage: 'zh-CN',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        url: siteUrl,
        name: siteTitle,
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: '首页',
            item: siteUrl,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: '关于我们',
            item: canonicalUrl,
          },
        ],
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: '机场梯子编辑部',
      alternateName: 'jichangtizi.net',
      url: siteUrl,
      email: 'contact@jichangtizi.net',
      description: '机场梯子（jichangtizi.net）专注机场推荐、品牌评测、客户端教程、节点订阅、线路协议和常见网络问题。',
      knowsAbout: [
        '机场推荐',
        '网络代理与专线评测',
        'Clash 配置与分流规则',
        'Mihomo 内核',
        'IEPL / IPLC 内网专线',
        '网络协议原理',
      ],
    },
  ],
};
---

<PageShell
  title={`关于我们 · ${siteTitle}`}
  description="机场梯子（jichangtizi.net）专注机场推荐、品牌评测、Clash / Mihomo 与网络工具使用指南。建立真实、客观、持续更新的中文网络工具知识库。"
  canonical={canonicalUrl}
  schema={aboutSchema}
  transparentHeader={true}
  pageId="about"
>
  <!-- 顶部 Hero 巨幕 (森林背景 + 标语说明) -->
  <HeroHeader
    text={aboutHero.text}
    subtitle={aboutHero.subtitle}
    backgroundImage={aboutHero.backgroundImage}
    compact={true}
  >
    <p class="hero-description-note">
      帮你看懂机场、选对工具、解决客户端与订阅使用问题。
    </p>
  </HeroHeader>

  <div class="stats-wrapper">
    <ContentCard id="stats-card" floating={true} class="about-card-wrapper">
      <div class="about-container">
        
        <!-- 01 / ABOUT 主卡片 -->
        <section class="about-main-section">
          <div class="section-badge-row">
            <span class="section-tag">01 / ABOUT</span>
          </div>

          <article class="brand-profile-card">
            <!-- 品牌专属矢量头像 (纸飞机 + 云层 + 网络节点 + 极简塔台) -->
            <div class="brand-avatar-box">
              <svg class="brand-avatar-svg" viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="机场梯子品牌徽标">
                <defs>
                  <linearGradient id="avatarBg" x1="0" y1="0" x2="240" y2="240" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#1b382b" />
                    <stop offset="50%" stop-color="#142c22" />
                    <stop offset="100%" stop-color="#0e1f18" />
                  </linearGradient>
                  <linearGradient id="planeGrad" x1="60" y1="50" x2="190" y2="170" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="100%" stop-color="#e8ece9" />
                  </linearGradient>
                  <linearGradient id="cloudGrad" x1="0" y1="0" x2="200" y2="100" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="rgba(255, 255, 255, 0.12)" />
                    <stop offset="100%" stop-color="rgba(255, 255, 255, 0.03)" />
                  </linearGradient>
                </defs>

                <!-- 背景深绿卡片圆角 -->
                <rect width="240" height="240" rx="36" fill="url(#avatarBg)" />
                <rect x="1" y="1" width="238" height="238" rx="35" stroke="rgba(255, 255, 255, 0.12)" stroke-width="1.5" />

                <!-- 背景网络拓扑连线与节点坐标 -->
                <g class="network-nodes" stroke="rgba(148, 163, 184, 0.25)" stroke-width="1.2" stroke-dasharray="3 3">
                  <line x1="40" y1="60" x2="90" y2="110" />
                  <line x1="90" y1="110" x2="190" y2="80" />
                  <line x1="90" y1="110" x2="160" y2="180" />
                  <line x1="50" y1="170" x2="160" y2="180" />
                </g>
                <circle cx="40" cy="60" r="3" fill="#6ee7b7" />
                <circle cx="190" cy="80" r="3.5" fill="#93c5fd" />
                <circle cx="50" cy="170" r="3" fill="#a7f3d0" />
                <circle cx="160" cy="180" r="3" fill="#6ee7b7" />

                <!-- 极简机场塔台剪影 (背景层) -->
                <path d="M175 195 V145 L180 135 H195 L200 145 V195 H175Z" fill="rgba(255, 255, 255, 0.08)" />
                <line x1="187.5" y1="135" x2="187.5" y2="125" stroke="rgba(110, 231, 183, 0.7)" stroke-width="1.5" />
                <circle cx="187.5" cy="123" r="2" fill="#6ee7b7" />

                <!-- 柔和云层线条 -->
                <path d="M25 185 C35 165, 65 165, 80 185 C95 170, 130 170, 145 185 C160 175, 195 175, 215 185 H25Z" fill="url(#cloudGrad)" />

                <!-- 航线轨迹曲线 -->
                <path d="M45 165 Q100 140, 135 95" stroke="#34d399" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.85" />
                <path d="M45 165 Q100 140, 135 95" stroke="#a7f3d0" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.25" filter="blur(2px)" />

                <!-- 核心主角：现代极简纸飞机 -->
                <g transform="translate(20, -5)">
                  <!-- 纸飞机阴影 -->
                  <path d="M125 98 L85 135 L165 72 Z" fill="rgba(0, 0, 0, 0.3)" />
                  <!-- 纸飞机机翼左翼 -->
                  <path d="M125 95 L65 125 L160 70 Z" fill="url(#planeGrad)" />
                  <!-- 纸飞机中折面 -->
                  <path d="M125 95 L160 70 L95 138 Z" fill="#d1d9d4" />
                  <!-- 纸飞机机翼右翼 -->
                  <path d="M125 95 L95 138 L145 128 Z" fill="#b8c5be" />
                  <!-- 飞机尖端微光 -->
                  <circle cx="160" cy="70" r="2.5" fill="#6ee7b7" />
                </g>
              </svg>
            </div>

            <!-- 编辑部核心信息 -->
            <div class="brand-profile-content">
              <h1 class="brand-title">机场梯子编辑部</h1>
              <div class="brand-identity-badge">
                机场评测 · 网络工具 · Clash / Mihomo 内容团队
              </div>

              <p class="brand-bio-text">
                机场梯子（jichangtizi.net）专注机场推荐、品牌评测、客户端教程、节点订阅、线路协议和常见网络问题。我们持续整理和更新相关资料，希望帮助用户更容易理解机场、客户端与网络工具之间的区别。
              </p>

              <!-- 信息标签 -->
              <div class="meta-tag-row">
                <span class="meta-tag-pill">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                  </svg>
                  中文网络工具指南
                </span>
                <a href="mailto:contact@jichangtizi.net" class="meta-tag-pill email-pill" title="联系编辑部">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                  contact@jichangtizi.net
                </a>
              </div>

              <!-- 内部 CTA 导航按钮 -->
              <div class="cta-actions-row">
                <a href="/" class="cta-btn primary-cta">
                  <span>机场推荐</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a href="/blog/" class="cta-btn secondary-cta">
                  <span>Clash 教程</span>
                </a>
                <a href="/blog/" class="cta-btn secondary-cta">
                  <span>风险数据库</span>
                </a>
              </div>
            </div>
          </article>
        </section>

        <div class="about-divider"></div>

        <!-- 02 / 我们关注什么 -->
        <section class="about-sub-section">
          <div class="section-badge-row">
            <span class="section-tag">02 / 我们关注什么</span>
          </div>
          <h2 class="sub-section-title">六大专业关注方向</h2>
          <p class="sub-section-intro">围绕网络代理生态链，深入梳理每个环节的核心痛点与技术逻辑。</p>

          <div class="focus-grid">
            <div class="focus-card">
              <div class="focus-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                </svg>
              </div>
              <h3 class="focus-card-title">机场推荐</h3>
              <p class="focus-card-desc">严选长期稳定运营、线路冗余充足、晚高峰具备真实承载力的优质节点服务商。</p>
            </div>

            <div class="focus-card">
              <div class="focus-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
              </div>
              <h3 class="focus-card-title">机场评测</h3>
              <p class="focus-card-desc">多地宽带实测、延迟抖动监测、4K/8K 跑分与 ChatGPT / 流媒体解锁能力真实遥测。</p>
            </div>

            <div class="focus-card">
              <div class="focus-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              </div>
              <h3 class="focus-card-title">Clash / Mihomo</h3>
              <p class="focus-card-desc">聚焦 Clash Verge Rev、Mihomo Party 等现代客户端的配置调优与智能分流规则集。</p>
            </div>

            <div class="focus-card">
              <div class="focus-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </div>
              <h3 class="focus-card-title">节点与订阅</h3>
              <p class="focus-card-desc">订阅格式解析、节点全红超时排查、自动化更新机制与客户端导入疑难解答。</p>
            </div>

            <div class="focus-card">
              <div class="focus-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              </div>
              <h3 class="focus-card-title">线路与协议</h3>
              <p class="focus-card-desc">通俗解读 IEPL 专线、BGP 中转、Hysteria 2、VLESS-Reality 等底层网络协议差异。</p>
            </div>

            <div class="focus-card">
              <div class="focus-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                  <line x1="12" y1="9" x2="12" y2="13"></line>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </div>
              <h3 class="focus-card-title">风险事件</h3>
              <p class="focus-card-desc">整理机场跑路前兆、失联预警、超售诈骗防范与用户资金安全避坑档案。</p>
            </div>
          </div>
        </section>

        <div class="about-divider"></div>

        <!-- 03 / 我们如何整理内容 -->
        <section class="about-sub-section">
          <div class="section-badge-row">
            <span class="section-tag">03 / 我们如何整理内容</span>
          </div>
          <h2 class="sub-section-title">内容整理与审核四项原则</h2>
          <p class="sub-section-intro">秉持严谨求实态度，确保输出的每份数据与教程经得起时间检验。</p>

          <div class="methods-grid">
            <div class="method-card">
              <div class="method-num">01</div>
              <h3 class="method-title">资料核对</h3>
              <p class="method-desc">多渠道交叉验证节点物理链路、机房落地 ASN 及运营历史，杜绝未经实测的虚假宣传。</p>
            </div>

            <div class="method-card">
              <div class="method-num">02</div>
              <h3 class="method-title">持续更新</h3>
              <p class="method-desc">紧跟客户端版本演进与网络环境变动，定期回溯复测所有推荐节点，标注最后实测时间。</p>
            </div>

            <div class="method-card">
              <div class="method-num">03</div>
              <h3 class="method-title">风险标记</h3>
              <p class="method-desc">对疑似超售拥堵、突发骨折促销或客服响应迟缓的品牌予以显著预警，保障用户知情权。</p>
            </div>

            <div class="method-card">
              <div class="method-num">04</div>
              <h3 class="method-title">避免绝对结论</h3>
              <p class="method-desc">各地运营商与本地网络千差万别，不存在绝对完美的产品，坚持客观呈现优劣与适用人群。</p>
            </div>
          </div>
        </section>

        <div class="about-divider"></div>

        <!-- 04 / 热门指南 -->
        <section class="about-sub-section">
          <div class="section-badge-row">
            <span class="section-tag">04 / 热门指南</span>
          </div>
          <h2 class="sub-section-title">核心导航与知识库入口</h2>
          <p class="sub-section-intro">快速直达精选评测、客户端配置手册与风险预警专题。</p>

          <div class="guides-grid">
            <a href="/" class="guide-item-link">
              <span class="guide-item-text">2026机场推荐</span>
              <span class="guide-arrow">↗</span>
            </a>
            <a href="/" class="guide-item-link">
              <span class="guide-item-text">稳定机场推荐</span>
              <span class="guide-arrow">↗</span>
            </a>
            <a href="/" class="guide-item-link">
              <span class="guide-item-text">性价比机场推荐</span>
              <span class="guide-arrow">↗</span>
            </a>
            <a href="/blog/" class="guide-item-link">
              <span class="guide-item-text">Clash使用教程</span>
              <span class="guide-arrow">↗</span>
            </a>
            <a href="/blog/" class="guide-item-link">
              <span class="guide-item-text">Clash Verge Rev教程</span>
              <span class="guide-arrow">↗</span>
            </a>
            <a href="/blog/" class="guide-item-link">
              <span class="guide-item-text">Mihomo教程</span>
              <span class="guide-arrow">↗</span>
            </a>
            <a href="/blog/" class="guide-item-link">
              <span class="guide-item-text">机场订阅怎么用</span>
              <span class="guide-arrow">↗</span>
            </a>
            <a href="/blog/" class="guide-item-link">
              <span class="guide-item-text">机场风险数据库</span>
              <span class="guide-arrow">↗</span>
            </a>
          </div>
        </section>

        <div class="about-divider"></div>

        <!-- 05 / 关于本站 -->
        <section class="about-sub-section">
          <div class="section-badge-row">
            <span class="section-tag">05 / 关于本站</span>
          </div>
          
          <div class="manifesto-box">
            <p class="manifesto-text">
              “机场梯子不是单纯的机场排行榜，而是围绕机场选择、客户端使用、节点订阅、线路协议和风险信息建立的中文网络工具知识库。”
            </p>
          </div>
        </section>

      </div>
    </ContentCard>
  </div>
</PageShell>

<style>
  /* 整体容器与卡片浮动 */
  .stats-wrapper {
    position: relative;
    width: 100%;
  }

  .about-container {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 22px;
    padding: clamp(1.8em, 4vw, 3em);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
    max-width: 1180px;
    margin: 0 auto;
  }

  /* Hero 额外说明文案 */
  .hero-description-note {
    font-size: 1.05em;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 0.6em;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
    letter-spacing: 0.2px;
  }

  /* 章节小标题徽章 */
  .section-badge-row {
    margin-bottom: 0.75em;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2em 0.6em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .sub-section-title {
    font-size: 1.5em;
    font-weight: 700;
    color: var(--color-text-strong);
    margin: 0 0 0.3em 0;
    letter-spacing: -0.01em;
  }

  .sub-section-intro {
    font-size: 0.95em;
    color: var(--color-text-secondary);
    margin: 0 0 1.8em 0;
    line-height: 1.6;
  }

  .about-divider {
    height: 1px;
    background: var(--color-border-subtle);
    margin: 3.2em 0 2.6em;
  }

  /* 01 / 主卡片布局 */
  .brand-profile-card {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 2.2em;
    align-items: center;
    padding: 1.8em;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 18px;
    margin-top: 0.6em;
  }

  .brand-avatar-box {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .brand-avatar-svg {
    width: 200px;
    height: 200px;
    border-radius: 30px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    transition: transform 0.3s ease;
  }

  .brand-avatar-svg:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .brand-profile-content {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .brand-title {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 800;
    color: var(--color-text-strong);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .brand-identity-badge {
    font-size: 0.92em;
    font-weight: 600;
    color: #1e704e;
