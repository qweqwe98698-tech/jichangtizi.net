---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

let rawCurrentPath = Astro.url.pathname;
try {
  rawCurrentPath = decodeURIComponent(rawCurrentPath);
} catch (_) {}
const currentPath = rawCurrentPath.replace(/\/$/, '') || '/';

let rawTargetPath = typeof href === 'string' ? href : '';
try {
  rawTargetPath = decodeURIComponent(rawTargetPath);
} catch (_) {}
const targetPath = rawTargetPath.replace(/\/$/, '') || '/';

const isActive = targetPath === '/'
  ? currentPath === '/'
  : currentPath.toLowerCase() === targetPath.toLowerCase() || currentPath.toLowerCase().startsWith(targetPath.toLowerCase() + '/');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>

