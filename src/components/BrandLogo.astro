---
interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  class:list={['brand-logo-svg', className]}
  aria-hidden="true"
>
  <defs>
    <!-- 背景圆形/圆角渐变 (蔚蓝至青蓝) -->
    <linearGradient id="plane-logo-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563eb" />
      <stop offset="60%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>

    <!-- 纸飞机光影渐变 -->
    <linearGradient id="origami-left" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#e0e7ff" />
    </linearGradient>

    <linearGradient id="origami-right" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#cbd5e1" />
      <stop offset="100%" stop-color="#94a3b8" />
    </linearGradient>

    <linearGradient id="origami-fold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#60a5fa" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>

    <!-- 阴影滤镜 -->
    <filter id="logo-plane-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-color="#1d4ed8" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- 蔚蓝圆角底座 -->
  <rect
    x="2"
    y="2"
    width="44"
    height="44"
    rx="12"
    fill="url(#plane-logo-bg)"
    filter="url(#logo-plane-shadow)"
  />

  <!-- 经纬度全球轨迹环 (象征全球专线) -->
  <circle
    cx="24"
    cy="24"
    r="16"
    fill="none"
    stroke="rgba(255, 255, 255, 0.3)"
    stroke-width="1.2"
    stroke-dasharray="3 2"
  />

  <ellipse
    cx="24"
    cy="24"
    rx="16"
    ry="6.5"
    fill="none"
    stroke="rgba(255, 255, 255, 0.45)"
    stroke-width="1.2"
    transform="rotate(-25 24 24)"
  />

  <!-- 节点光点 -->
  <circle cx="10" cy="18" r="2" fill="#ffffff" opacity="0.95" />
  <circle cx="38" cy="30" r="2" fill="#ffffff" opacity="0.95" />
  <circle cx="33" cy="14" r="1.5" fill="#67e8f9" opacity="0.95" />

  <!-- 核心 Origami 纸飞机 / 冲霄图腾 -->
  <g transform="translate(1, 0)">
    <!-- 飞机左翼 (高亮明面) -->
    <polygon
      points="36,12 14,24 23,27"
      fill="url(#origami-left)"
    />

    <!-- 飞机右翼 (阴影折面) -->
    <polygon
      points="36,12 23,27 26,36"
      fill="url(#origami-right)"
    />

    <!-- 飞机中轴折角底翼 -->
    <polygon
      points="23,27 26,36 27,29"
      fill="url(#origami-fold)"
    />
  </g>

  <!-- 顶部加速极速流光 -->
  <path
    d="M 38 10 L 41 7"
    stroke="#ffffff"
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.95"
  />
</svg>

<style>
  .brand-logo-svg {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    border-radius: 8px;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(a:hover) .brand-logo-svg {
    transform: scale(1.08) rotate(4deg);
  }
</style>
